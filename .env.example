SOVAI_APP_NAME=SovereignAI Workbench API
SOVAI_APP_ENV=development
SOVAI_OFFLINE_MODE=true
SOVAI_MODEL_ENDPOINT=http://127.0.0.1:11434
SOVAI_MAX_UPLOAD_SIZE_BYTES=10485760
SOVAI_DATA_ROOT=/workspace/data
SOVAI_INPUT_DIR=/workspace/data/inputs
SOVAI_OUTPUT_DIR=/workspace/data/outputs
SOVAI_TMP_DIR=/workspace/data/tmp
SOVAI_VECTOR_STORE_DIR=/workspace/data/vector_store
SOVAI_AUDIT_DIR=/workspace/data/audit
VITE_API_BASE_URL=http://localhost:8000
